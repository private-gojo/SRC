<?xml version='1.0' encoding='utf-8'?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.slipkprojects.sockshttp">

	<uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:name="com.ace.injector.SocksHttpApp"
        android:allowBackup="true"
        android:icon="@drawable/ace_launchers"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:resizeableActivity="true"
        android:extractNativeLibs="true"
		android:debuggable="true"
		android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name="com.ace.injector.LauncherActivity"
            android:theme="@style/SplashScreenTheme"
            android:label="@string/app_name">

            <intent-filter>

                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>

            </intent-filter>

        </activity>
		
		<activity android:name="com.ace.injector.errors"/>
			
		<activity android:name="com.ace.injector.util.MyIP_Address"
            android:theme="@style/AppTheme"/>
		
		<activity android:name="com.ace.injector.HostChecker"
			android:windowSoftInputMode="adjustPan"
			android:launchMode="singleTask"
			android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
			android:parentActivityName="com.ace.injector.SocksHttpMainActivity"
            android:label="Host Checker"/>
			
		<activity
            android:name="com.ace.injector.TunnelActivity"
			android:parentActivityName="com.ace.injector.SocksHttpMainActivity"
            android:label="@string/app_name"/>

        <activity
            android:name="com.ace.injector.SocksHttpMainActivity"
            android:label="@string/app_name"/>

        <activity
            android:name="com.ace.injector.activities.ConfigGeralActivity"
            android:parentActivityName="com.ace.injector.SocksHttpMainActivity"
            android:label="@string/settings"/>

        <activity
            android:name="com.ace.injector.activities.ConfigImportFileActivity"
            android:grantUriPermissions="true"
            android:parentActivityName="com.ace.injector.SocksHttpMainActivity"
            android:label="@string/settings_import">

            <intent-filter>

                <action android:name="android.intent.action.VIEW"/>

                <category android:name="android.intent.category.DEFAULT"/>

                <category android:name="android.intent.category.BROWSABLE"/>

                <data android:scheme="file"/>

                <data android:scheme="content"/>

                <data android:mimeType="*/*"/>

                <data android:host="*"/>

                <data android:port="*"/>

                <data android:pathPattern=".*.aip"/>

                <data android:pathPattern=".*..*.aip"/>

                <data android:pathPattern=".*..*..*.aip"/>

                <data android:pathPattern=".*..*..*..*.aip"/>

                <data android:pathPattern=".*..*..*..*..*.aip"/>

                <data android:pathPattern=".*..*..*..*..*..*.aip"/>

                <data android:pathPattern=".*..*..*..*..*..*..*.aip"/>

            </intent-filter>

        </activity>
		
		<activity android:name="com.ace.injector.CustomDNS"
			android:parentActivityName="com.ace.injector.SocksHttpMainActivity"
            android:label="Set DNS"/>

        <activity
            android:name="com.ace.injector.activities.ConfigExportFileActivity"
            android:parentActivityName="com.ace.injector.SocksHttpMainActivity"
            android:label="@string/settings_export"/>

        <activity
            android:name="com.ace.injector.activities.AboutActivity"
            android:parentActivityName="com.ace.injector.SocksHttpMainActivity"
            android:label="@string/about"/>
		
		<activity android:name="com.ultrasshservice.LaunchVpn"
			android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.ultrasshservice.LaunchVPN"
			android:theme="@style/AppThemeLogin" 
			android:label="@string/app_name">
			<intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
		
		<receiver
			android:name="com.ultrasshservice.MainReceiver">
			<intent-filter>
				<action
					android:name="com.ultrasshservice.MainReceiver.ACTION_SERVICE_STOP">
				</action>
				<action
					android:name="com.ultrasshservice.MainReceiver.ACTION_SERVICE_RESTART">
				</action>
			</intent-filter>
		</receiver>


		<!--- Services -->
		<service android:label="Ace Injector"
			android:name="com.ultrasshservice.tunnel.vpn.TunnelVpnService"
			android:exported="false"
			android:enabled="true"
			android:permission="android.permission.BIND_VPN_SERVICE">
			<intent-filter>
				<action android:name="android.net.VpnService"/>
			</intent-filter>
		</service>

		<service android:label="SocksHttp Service"
			android:name="com.ultrasshservice.SocksHttpService"
			android:stopWithTask="false"
			android:exported="false">
		</service>
		
		<meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize" />
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-4327217352829821~9017714353"/>
        <meta-data android:name="com.google.android.gms.ads.AD_MANAGER_APP"
			android:value="true" />

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false"/>

    </application>

</manifest>
